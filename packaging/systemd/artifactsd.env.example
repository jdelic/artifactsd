# Example environment file for the artifactsd systemd unit.
# Copy to /etc/artifactsd.env (mode 640, owned by root:artifactsd) and fill in
# real values. See docs/configuration.md for the full reference.

ARTIFACTSD_LISTEN=:443
ARTIFACTSD_BASE_URL=https://artifacts.example.com
ARTIFACTSD_DATA_DIR=/var/lib/artifactsd

# Automatic TLS via Let's Encrypt. Use --tls=files instead if you terminate
# TLS yourself.
ARTIFACTSD_TLS=acme
ARTIFACTSD_ACME_DOMAINS=artifacts.example.com
ARTIFACTSD_ACME_EMAIL=admin@example.com

# Seeds an admin-scoped API token on first boot so you have a way in.
# Generate a long random value and drop this line once a real admin token
# exists.
ARTIFACTSD_BOOTSTRAP_TOKEN=change-me
